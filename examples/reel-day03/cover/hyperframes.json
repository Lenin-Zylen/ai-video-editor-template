      "type": "hyperframes:component",
      "target": "compositions/components/zoom-through-transition.html"
    },
    {
      "name": "typed-prompt",
      "type": "hyperframes:component",
      "target": "compositions/components/typed-prompt.html"
    }
  ]
}
